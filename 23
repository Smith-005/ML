"""Experiment 23: Clustering Algorithms.

Compare K-Means, Agglomerative Clustering, and Gaussian Mixture Model
on a synthetic dataset of four clusters.
"""

from sklearn.datasets import make_blobs
from sklearn.cluster import KMeans, AgglomerativeClustering
from sklearn.mixture import GaussianMixture
import matplotlib.pyplot as plt

# Generate Synthetic Dataset
X, _ = make_blobs(
    n_samples=300,
    centers=4,
    cluster_std=0.60,
    random_state=42
)

# Create 3 Subplots
fig, axes = plt.subplots(1, 3, figsize=(15, 4))

# 1. K-Means Clustering
kmeans = KMeans(n_clusters=4, random_state=42, n_init=10)
kmeans_labels = kmeans.fit_predict(X)

axes[0].scatter(X[:, 0], X[:, 1],
                c=kmeans_labels, cmap='viridis')
axes[0].set_title('K-Means Clustering')

# 2. Agglomerative Clustering
agg = AgglomerativeClustering(n_clusters=4)
agg_labels = agg.fit_predict(X)

axes[1].scatter(X[:, 0], X[:, 1],
                c=agg_labels, cmap='viridis')
axes[1].set_title('Agglomerative Clustering')

# 3. Gaussian Mixture Model
gmm = GaussianMixture(n_components=4, random_state=42)
gmm_labels = gmm.fit_predict(X)

axes[2].scatter(X[:, 0], X[:, 1],
                c=gmm_labels, cmap='viridis')
axes[2].set_title('Gaussian Mixture Model')

# Display Graphs
plt.tight_layout()
plt.show()

